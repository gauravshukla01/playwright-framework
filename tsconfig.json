{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "@playwright/test"],
    "outDir": "./dist"
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
  "node_modules",
  "dist",
  "playwright-report",
  "test-results",
  "contracts/pacts",
  "contracts"
  ]
}